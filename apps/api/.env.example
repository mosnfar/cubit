# Mubit inference key of the nightshift-product project
MUBIT_API_KEY=
MUBIT_BASE_URL=https://api.mubit.ai
# The moderation task Mubit trains. Changing the model starts a new task.
MOD_MODEL=gpt-6-luna
# Model that writes swarm chat. Its calls are sent unrecorded.
SWARM_MODEL=gpt-4.1-mini
MOD_CONCURRENCY=16
PORT=4000
WEB_ORIGIN=http://localhost:3100
# Optional: OpenAI list price of MOD_MODEL in USD per 1M tokens, for the cost column
GPT_PRICE_IN=
GPT_PRICE_OUT=
# Open model the benchmark compares against (via OpenRouter, through Mubit)
EVAL_OPEN_MODEL=qwen/qwen3-30b-a3b-instruct-2507
